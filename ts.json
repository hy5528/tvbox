            "hosts": [
                "t.cn",
                "short.url",
                "dwz.cn",
                "url.cn"
            ],
            "followRedirect": true,
            "maxRedirects": 5
        },
        {
            "name": "关闭通用弹窗",
            "hosts": [
                "*"
