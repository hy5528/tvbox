            "regex": [
                "/"
            ],
            "script": [
                "document.querySelectorAll('.modal-close,.close-btn,.popup-close,.layui-layer-close,.swal-close,[class*=\"close\"]').forEach(el=>el.click())"
            ]
        },
        {
            "name": "跳过验证码",
            "hosts": [
                "*"
            ],
            "regex": [
                "/captcha/",
                "/verify/",
                "/validate/"
            ],
            "action": "block",
            "priority": 9
        },
        {
            "name": "移除浮层遮罩",
            "hosts": [
                "*"
            ],
            "script": [
                "document.querySelectorAll('.mask,.overlay,.modal-mask,.popup-overlay,.layui-layer-shade').forEach(el=>el.style.display='none')"
            ]
        },
