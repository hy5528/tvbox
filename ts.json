                "/video/",
                "/bangumi/"
            ],
            "script": [
                "window.__INITIAL_STATE__ && window.__INITIAL_STATE__.videoData && window.__INITIAL_STATE__.videoData.pages"
            ]
        },
        {
            "name": "微博嗅探",
            "hosts": [
                "weibo.com",
                "m.weibo.cn"
            ],
            "regex": [
                "/status/"
